NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=rishirides
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=1h
CLIENT_ORIGINS=http://localhost:8081,http://localhost:5173
OTP_PROVIDER=email-smtp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASSWORD=your-16-character-google-app-password
SMTP_FROM=your-gmail-address@gmail.com
GOOGLE_OAUTH_CLIENT_IDS=web-client-id.apps.googleusercontent.com,ios-client-id.apps.googleusercontent.com,android-client-id.apps.googleusercontent.com
