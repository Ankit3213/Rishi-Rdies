{
  "expo": {
    "name": "RishiRides",
    "slug": "RishiRides",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "rishirides",
    "ios": {
      "bundleIdentifier": "com.rishirides.app"
    },
    "android": {
      "package": "com.rishirides.app",
      "googleServicesFile": "./google-services.json"
    },
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#315C4D"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "RishiRide uses your location to set your pickup point when you ask it to."
        }
      ],
      "expo-web-browser",
      "expo-image",
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
